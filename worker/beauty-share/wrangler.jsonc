{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sullyos-beauty-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "account_id": "2cd975a0e2a9d667b85119c456d9478f",
  "workers_dev": true,
  "routes": [{ "pattern": "beauty.friedsully.com", "custom_domain": true }],
  "assets": { "directory": "./admin", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "sullyos-beauty-share", "database_id": "a236aede-d420-4c96-981a-dced147ca8a5", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "sullyos-beauty-share-private" }],
  "triggers": { "crons": ["17 19 * * *"] },
  "vars": { "UPLOADS_ENABLED": "true", "DAILY_UPLOAD_BYTES": "268435456", "TOTAL_STORAGE_BYTES": "8589934592" },
  "observability": { "enabled": false }
}
